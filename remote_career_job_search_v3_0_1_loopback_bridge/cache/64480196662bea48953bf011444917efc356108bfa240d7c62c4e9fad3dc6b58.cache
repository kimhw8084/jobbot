<style>
  /* Global */
  body {
    -webkit-font-smoothing: antialiased;
    -moz-font-smoothing: antialiased;
    -o-font-smoothing: antialiased;
  }

  a {
    overflow-wrap: break-word;
    word-wrap: break-word;
  }

  a:hover .list-links-w-arrow-heading.mt-0.mb-0.faq {
    color: #5353ed !important;
  }

  .list-links-w-arrow-heading.mt-0.mb-0.faq {
    color: #000 !important;
  }

  /* Slider */
  .w-slider-nav .w-slider-dot {
    width: 1em;
    height: 1em;
  }

  /* Mobile (single merged query) */
  @media screen and (max-width: 479px) {
    .treatment-left-cta {
      width: 100%;
      justify-content: center;
    }

    .callout-block {
      text-align: center;
      width: 100%;
      margin-top: 15px;
    }
  }

  /* Callout blocks */
  .background-purple .callout-block {
    color: #fff;
  }

  .background-color-cyan .callout-block {
    color: #000;
  }

  .background-color-cyan .treatment-hero .callout-block {
    color: #000;
  }

  .callout-block {
    color: #000;
    display: inline;
    line-height: 120%;
    font-size: 15px;
    margin-top: 25px;
  }

  .build-a-future .callout-block,
  .treatment-hero .callout-block,
  .suboxone-fit-for-you .callout-block {
    color: #fff;
    display: block;
  }

  /* Nav and menu */
  .menu-button.w--open .menu-bar-icon {
    display: none;
  }

  .menu-button.w--open .menu-close-icon {
    display: block;
  }

  .sticky-top-bar {
    top: 71px !important;
  }

  .btn.btn-outline-purple.dropdown.w--open {
    background-color: #5353ed !important;
  }

  .nav-dropdown-link.w--current,
  .nav-link.w--current {
    color: #5353ed !important;
  }

  @media screen and (max-width: 990px) {
    .nav-dropdown-toggle.w--open {
      color: #5353ed !important;
      font-weight: normal;
      border-bottom: solid 1px #5353ed;
      margin-bottom: 20px;
    }
  }

  @media screen and (min-width: 991px) {
    .sticky-top-bar {
      top: 80px !important;
    }
  }

  /* Button groups */
  @media screen and (min-width: 768px) {
    .btn-group .btn + .btn {
      margin-left: 8px;
    }
  }

  @media screen and (max-width: 767px) {
    .btn-group .btn {
      margin-bottom: 8px;
    }
  }

  /* Collapse group */
  .accordion__item.js-accordion-item.active .accordion-header:after,
  .accordion__item.js-accordion-item.active .accordion-header .question-text {
    color: #e47f48;
  }

  @media screen and (max-height: 768px) {
    .nav-scroll-desktop {
      max-height: 80vh;
      overflow-x: auto;
    }
  }

  /* Skip link focus */
  #main-content[tabindex='-1']:focus {
    outline: none;
  }
  /*Fixes Branding */
  .section.background-lavender a,
  .section.background-lavender a:hover {
    color: white;
  }
</style>
