(function () {
  'use strict';

  var BASE    = 'https://bicyclehealth.com';
  var ORG_ID  = BASE + '/#organization';
  var SITE_ID = BASE + '/#website';

  // ── Helpers ──────────────────────────────────────────────────────

  function attr(selector, attribute) {
    var el = document.querySelector(selector);
    return el ? (el.getAttribute(attribute) || '').trim() : '';
  }

  function pathname() {
    return window.location.pathname.replace(/\/$/, '').toLowerCase() || '/';
  }

  function headline() {
    var title = (document.title || '')
      .replace(/\s*[\|\-\u2013\u2014]\s*Bicycle Health\s*$/i, '')
      .trim();
    return title || 'Careers at Bicycle Health';
  }

  // ── Page-specific config ─────────────────────────────────────────

  function pageConfig(path) {
    if (path === '/careers-opportunities') {
      return {
        name:        'Open Positions at Bicycle Health',
        description: 'Browse open clinical and non-clinical positions at Bicycle Health, the leading telehealth provider of medication for opioid use disorder.',
        about: {
          '@type': 'Occupation',
          'name':  'Healthcare and Telehealth Roles',
          'occupationalCategory': '29-0000',
          'occupationLocation': {
            '@type':       'Country',
            'name':        'United States'
          }
        },
        significantLink: BASE + '/careers'
      };
    }

    // Default: /careers
    return {
      name:        headline(),
      description: attr('meta[property="og:description"]', 'content')
                || attr('meta[name="description"]', 'content')
                || 'Join Bicycle Health, the leading telehealth provider of medication for opioid use disorder.',
      about: {
        '@type': 'Occupation',
        'name':  'Healthcare and Telehealth Roles',
        'occupationalCategory': '29-0000',
        'occupationLocation': {
          '@type': 'Country',
          'name':  'United States'
        }
      },
      significantLink: BASE + '/careers-opportunities'
    };
  }

  // ── Build ────────────────────────────────────────────────────────

  (function () {
    var path         = pathname();
    var canonicalEl  = document.querySelector('link[rel="canonical"]');
    var canonicalUrl = canonicalEl ? canonicalEl.href : (BASE + path);
    var config       = pageConfig(path);

    var schema = {
      '@context':       'https://schema.org',
      '@type':          'CollectionPage',
      '@id':            canonicalUrl + '#collectionpage',
      'url':            canonicalUrl,
      'name':           config.name,
      'description':    config.description,
      'publisher':      { '@id': ORG_ID },
      'isPartOf':       { '@id': SITE_ID },
      'inLanguage':     'en-US',
      'about':          config.about,
      'significantLink': config.significantLink
    };

    var el = document.createElement('script');
    el.type = 'application/ld+json';
    el.textContent = JSON.stringify(schema, null, 2);
    document.head.appendChild(el);
  })();

})();
</script></div><script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=61f7c8145fe6f608faa84b36" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/61f7c8145fe6f608faa84b36/js/bicyclehealth-staging-redesign.schunk.36b8fb49256177c8.js" type="text/javascript" integrity="sha384-4abIlA5/v7XaW1HMXKBgnUuhnjBYJ/Z9C1OSg4OhmVw9O3QeHJ/qJqFBERCDPv7G" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/61f7c8145fe6f608faa84b36/js/bicyclehealth-staging-redesign.schunk.e4ffc18a84f17441.js" type="text/javascript" integrity="sha384-ZkvO8eBCBEP4Z/HpLZtkeBmyS1l6kif7YOmONgtpqHTyy0pTEBACS0nGuz4bu8qo" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/61f7c8145fe6f608faa84b36/js/bicyclehealth-staging-redesign.ff8be283.a27be65ce1d1ac02.js" type="text/javascript" integrity="sha384-TpnE3ieWJsMiRuqBHnMcaMFSFasiJAZujjlOCRuDOnj09ca2yw2S5CovLrt2D0a1" crossorigin="anonymous"></script><!-- MixPanel Event Captured -->
