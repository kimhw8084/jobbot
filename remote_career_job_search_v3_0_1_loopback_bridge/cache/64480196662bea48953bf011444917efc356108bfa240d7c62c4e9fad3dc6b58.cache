<!-- End Google Tag Manager (noscript) --></div><div class="s--menu-script w-embed w-script"><script>
/* Bicycle Health global navigation — behaviour only.
   Every visual state is a Webflow class: is--open, is--wide, is--top-open,
   is--mid-open, is--bottom-open. Edit the look in Designer, not here.
   Elements are found by data-* hooks so class renames cannot break the script. */
(function () {
  'use strict';

  var DESKTOP = '(min-width: 992px)';
  var CLOSE_DELAY = 160;
  var OPEN = 'is--open';
  var WIDE = 'is--wide';

  function isDesktop() { return window.matchMedia(DESKTOP).matches; }

  function mark(el, name, on) {
    if (!el) { return; }
    if (on) { el.classList.add(name); } else { el.classList.remove(name); }
  }

  function initNav(root) {
    var burger = root.querySelector('[data-nav-burger]');
    var menu = root.querySelector('[data-nav-menu]');
    var lines = burger ? burger.querySelectorAll('[data-nav-burger-line]') : [];
    var items = Array.prototype.slice.call(root.querySelectorAll('[data-nav-item]'));
    var closeTimer = null;

    function parts(item) {
      return {
        trigger: item.querySelector('[data-nav-trigger]'),
        link: item.querySelector('.c-nav--link'),
        chevron: item.querySelector('.c-nav--chevron'),
        icon: item.querySelector('.c-nav--chevron-icon'),
        panel: item.querySelector('[data-nav-panel]'),
        inner: item.querySelector('.c-nav--panel-inner'),
        divider: item.querySelector('.c-nav--divider')
      };
    }

    function isOpen(item) {
      var panel = item.querySelector('[data-nav-panel]');
      return !!panel && panel.classList.contains(OPEN);
    }

    function closeSubs(item) {
      var p = parts(item);
      Array.prototype.forEach.call(item.querySelectorAll('[data-nav-sub]'), function (sub) {
        mark(sub.querySelector('[data-nav-sub-trigger]'), OPEN, false);
        mark(sub.querySelector('.c-nav--sub-icon'), OPEN, false);
        mark(sub.querySelector('[data-nav-subpanel]'), OPEN, false);
        var t = sub.querySelector('[data-nav-sub-trigger]');
        if (t) { t.setAttribute('aria-expanded', 'false'); }
      });
      mark(p.inner, WIDE, false);
      mark(p.divider, OPEN, false);
    }

    function closeItem(item) {
      var p = parts(item);
      mark(p.panel, OPEN, false);
      mark(p.link, OPEN, false);
      mark(p.chevron, OPEN, false);
      mark(p.icon, OPEN, false);
      if (p.trigger) { p.trigger.setAttribute('aria-expanded', 'false'); }
      closeSubs(item);
    }

    function closeAll() { items.forEach(closeItem); }

    function openItem(item) {
      items.forEach(function (other) { if (other !== item) { closeItem(other); } });
      var p = parts(item);
      mark(p.panel, OPEN, true);
      mark(p.link, OPEN, true);
      mark(p.chevron, OPEN, true);
      mark(p.icon, OPEN, true);
      if (p.trigger) { p.trigger.setAttribute('aria-expanded', 'true'); }
    }

    function openSub(item, sub) {
      var subpanel = sub.querySelector('[data-nav-subpanel]');
      var already = !!subpanel && subpanel.classList.contains(OPEN);
      if (already && isDesktop()) { return; }
      closeSubs(item);
      if (already) { return; }
      var t = sub.querySelector('[data-nav-sub-trigger]');
      mark(t, OPEN, true);
      mark(sub.querySelector('.c-nav--sub-icon'), OPEN, true);
      mark(subpanel, OPEN, true);
      if (t) { t.setAttribute('aria-expanded', 'true'); }
      if (isDesktop()) {
        var p = parts(item);
        mark(p.inner, WIDE, true);
        mark(p.divider, OPEN, true);
      }
    }

    function onActivate(el, fn) {
      el.addEventListener('click', function (event) { event.preventDefault(); fn(); });
      el.addEventListener('keydown', function (event) {
        if (event.key === 'Enter' || event.key === ' ' || event.key === 'Spacebar' ||
            event.keyCode === 13 || event.keyCode === 32) {
          event.preventDefault();
          fn();
        }
      });
    }

    items.forEach(function (item) {
      var trigger = item.querySelector('[data-nav-trigger]');
      if (trigger) {
        onActivate(trigger, function () {
          if (isOpen(item)) { closeItem(item); } else { openItem(item); }
        });
      }

      item.addEventListener('mouseenter', function () {
        if (!isDesktop()) { return; }
        window.clearTimeout(closeTimer);
        openItem(item);
      });
      item.addEventListener('mouseleave', function () {
        if (!isDesktop()) { return; }
        window.clearTimeout(closeTimer);
        closeTimer = window.setTimeout(function () { closeItem(item); }, CLOSE_DELAY);
      });
      item.addEventListener('focusin', function () {
        if (!isDesktop()) { return; }
        window.clearTimeout(closeTimer);
        openItem(item);
      });
      item.addEventListener('focusout', function (event) {
        if (!isDesktop()) { return; }
        if (item.contains(event.relatedTarget)) { return; }
        closeItem(item);
      });

      Array.prototype.forEach.call(item.querySelectorAll('[data-nav-sub]'), function (sub) {
        var subTrigger = sub.querySelector('[data-nav-sub-trigger]');
        if (!subTrigger) { return; }
        onActivate(subTrigger, function () { openSub(item, sub); });
        sub.addEventListener('mouseenter', function () {
          if (!isDesktop()) { return; }
          openSub(item, sub);
        });
      });
    });

    var LINE_CLOSED = ['is--top', 'is--mid', 'is--bottom'];
    var LINE_OPEN = ['is--top-open', 'is--mid-open', 'is--bottom-open'];

    function menuIsOpen() { return !!menu && menu.classList.contains(OPEN); }

    function setMenu(open) {
      mark(menu, OPEN, open);
      Array.prototype.forEach.call(lines, function (line, i) {
        mark(line, LINE_CLOSED[i], !open);
        mark(line, LINE_OPEN[i], open);
      });
      if (burger) { burger.setAttribute('aria-expanded', open ? 'true' : 'false'); }
      if (!open) { closeAll(); }
    }

    if (burger) {
      onActivate(burger, function () { setMenu(!menuIsOpen()); });
    }

    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape' && event.keyCode !== 27) { return; }
      if (menuIsOpen()) {
        setMenu(false);
        if (burger) { burger.focus(); }
        return;
      }
      for (var i = 0; i < items.length; i++) {
        if (isOpen(items[i])) {
          var t = items[i].querySelector('[data-nav-trigger]');
          closeItem(items[i]);
          if (t) { t.focus(); }
          return;
        }
      }
    });

    document.addEventListener('click', function (event) {
      if (root.contains(event.target)) { return; }
      closeAll();
      if (menuIsOpen()) { setMenu(false); }
    });

    var lastDesktop = isDesktop();
    window.addEventListener('resize', function () {
      var now = isDesktop();
      if (now === lastDesktop) { return; }
      lastDesktop = now;
      setMenu(false);
    });
  }

  function run() {
    Array.prototype.forEach.call(document.querySelectorAll('[data-nav]'), initNav);
  }

  if (document.readyState !== 'loading') { run(); }
  else { document.addEventListener('DOMContentLoaded', run); }
}());
</script></div></div><main id="main-content" class="main__content"><section id="openpositions" class="section is--off-white"><div class="container w-container"><h1>Open positions at Bicycle Health</h1><p class="fs-18">Bicycle Health is a telemedicine group that specializes in the evidence-based treatment of patients with Opioid Use Disorder using Medication for Addiction Treatment and Integrated Behavioral Health. We’ve grown to a staff of 150+ team members, including medical providers caring for patients across 32 states.</p></div></section><div class="section pt-0 is--off-white"><div class="container w-container"><div id="grnhse_app"></div></div></div></main><section data-wf--recruiting-scam--variant="white" class="l-section is--off-white is--pad-md w-variant-e2234e2d-24df-46a0-499f-05c0c2ec62cd"><div class="l-container"><div class="c-split is--top"><div class="c-split--copy is--narrow is--tight"><div class="c-why--icon"><div data-wf--icon----global--variant="34-verified-badge" class="c-icon w-variant-49889c69-ce79-d316-32a9-62e12b72484d"></div></div><h2 class="heading--card">Recruiting safety notice</h2><p class="text--body">We’re aware of fraudulent recruiting messages that claim to represent Bicycle Health. <br/><br/>If you believe you have been contacted by someone misrepresenting our company, please report it to <a href="mailto:careers@bicyclehealth.com?subject=Recruiting%20Scam">careers@bicyclehealth.com</a></p></div><div class="c-split--copy is--tight"><div class="c-step--list"><p class="text--emphasis">Official communication</p><p class="text--body">Always comes from an @bicyclehealth.com email address.</p></div><div class="c-step--list"><p class="text--emphasis">We will never ask you to pay</p><p class="text--body">For fees, equipment, or provide financial information as part of hiring.</p></div><div class="c-step--list"><p class="text--emphasis">We will never request</p><p class="text--body">Your Social Security number or banking information before an offer is made.</p></div><div class="c-step--list"><p class="text--emphasis">We only interview</p><p class="text--body">Through legitimate, scheduled channels, and never make offers by text or chat apps.</p></div></div></div></div></section><footer id="footer" class="footer"><div aria-label="Get Help &amp; Answers Now" role="region" class="help-panel"><div aria-controls="help-panel-options" role="button" tabindex="0" class="help-panel-header"><div class="chat-icon"><div data-wf--icon----global--variant="09-chat-support" class="c-icon w-variant-3e7f8e27-7ed7-3bb3-0a8d-063ed716664f"></div></div><div class="text-block-37">Get Help &amp; Answers Now</div><img src="https://cdn.prod.website-files.com/61f7c8145fe6f608faa84b36/64921548c17ac4021c4314e7_chevron-up.svg" loading="lazy" aria-hidden="true" alt="Chevron up icon"/></div><div id="help-panel-options" class="help-panel-options"><h2 class="help-panel-label">How can we help?</h2><ul role="list" class="list--reset w-list-unstyled"><li><a data-tracker="click_chat_signup|Chat" data-w-id="ab952433-20a6-9c30-bd53-d0fd6f0e833d" href="/we-are-here-to-help" class="help-panel-option w-inline-block"><div class="help-panel-option-bullet"></div><div data-w-id="ab952433-20a6-9c30-bd53-d0fd6f0e833f" class="text-block-40">I&#x27;m ready to sign up!</div></a></li><li><a data-tracker="click_chat_insurance|Chat" data-w-id="ab952433-20a6-9c30-bd53-d0fd6f0e8341" href="/insurance-and-pricing" class="help-panel-option w-inline-block"><div class="help-panel-option-bullet"></div><div>Check my insurance</div></a></li><li><a data-tracker="click_chat_questions|Chat" data-w-id="ab952433-20a6-9c30-bd53-d0fd6f0e8345" href="/how-it-works" class="help-panel-option w-inline-block"><div class="help-panel-option-bullet"></div><div>I have a few questions.</div></a></li><li><a data-tracker="click_chat_referral|Chat" data-w-id="ab952433-20a6-9c30-bd53-d0fd6f0e8349" href="/refer" class="help-panel-option w-inline-block"><div class="help-panel-option-bullet"></div><div>I need to refer someone</div></a></li></ul></div><div class="hide w-embed w-script"><style>
