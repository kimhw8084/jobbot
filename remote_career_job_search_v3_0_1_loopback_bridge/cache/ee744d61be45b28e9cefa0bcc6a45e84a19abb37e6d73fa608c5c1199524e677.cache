<!-- Neutralize Webflow's stock anti-flicker (html.anti-flicker outranks
     .anti-flicker, so their hide never takes effect).-->
<style>
  html.anti-flicker, html.anti-flicker * {
    visibility: visible !important;
    opacity: 1 !important;
  }
</style>
<script type="text/javascript">
  (function () {
    if (!window.location.hostname.includes('talkspace.com')) return;

    const isDevCanary = window.location.hostname.includes('.dev.talkspace.com') || window.location.hostname.includes('.canary.talkspace.com');
    const logger = (message, props = '') => {
      if (isDevCanary) console.log(message, props);
    };

    // ── pollUntil: single retry primitive ───────────────────────────────────
    // Calls fn() every `every` ms until it returns true or `timeout` ms pass.
    // Returns a cancel() so callers can stop it early (e.g. on re-evaluation).
    const pollUntil = (fn, { every, timeout }) => {
      // Fire once immediately so a value that's already present resolves without
      // waiting a full interval.
      if (fn()) return () => {};
      const id = setInterval(() => {
        if (fn()) clearInterval(id);
      }, every);
      const to = setTimeout(() => clearInterval(id), timeout);
      return () => {
        clearInterval(id);
        clearTimeout(to);
      };
    };

    // ── Cookie cleanup on consent revocation ────────────────────────────────
    window.OptanonWrapper = () => {
      const currentGroupsStr = window.OnetrustActiveGroups || '';
      const previousGroupsStr = window.otLastActiveGroups || currentGroupsStr;

      window.otLastActiveGroups = currentGroupsStr;

      const parseGroups = (str) => str.split(',').filter(Boolean);
      const current = parseGroups(currentGroupsStr);
      const previous = parseGroups(previousGroupsStr);

      const removedIds = previous.filter((id) => !current.includes(id));

      if (removedIds.length === 0) return;

      const domainData = window.Optanon?.GetDomainData()?.Groups || [];
      const cookiesToDelete = new Set();

      domainData.forEach((group) => {
        const categoryMatch = removedIds.includes(group.CustomGroupId);

        if (categoryMatch) {
          group.Cookies?.forEach((c) => cookiesToDelete.add(c.Name));
        }

        group.Hosts?.forEach((host) => {
          if (removedIds.includes(host.HostId) || categoryMatch) {
            host.Cookies?.forEach((c) => cookiesToDelete.add(c.Name));
          }
        });
      });

      const domainName = '.talkspace.com';

      cookiesToDelete.forEach((name) => {
        try {
          localStorage.removeItem(name);
        } catch (e) {}

        const expires = 'Max-Age=-99999999;';
        document.cookie = `${name}=; ${expires} Path=/; Domain=${domainName}`;
        document.cookie = `${name}=; ${expires} Path=/;`;

        const pathSegments = window.location.pathname.split('/');
        pathSegments.forEach((_, i) => {
          const currentPath = pathSegments.slice(0, i + 1).join('/') || '/';
          document.cookie = `${name}=; ${expires} Path=${currentPath}; Domain=${domainName}`;
          document.cookie = `${name}=; ${expires} Path=${currentPath};`;
          document.cookie = `${name}=; ${expires} Path=${currentPath}/; Domain=${domainName}`;
          document.cookie = `${name}=; ${expires} Path=${currentPath}/;`;
        });
      });

      console.log(`OptanonWrapper: Removed cookies for groups [${removedIds.join(', ')}]`);
    };

    // ── Consent → Optimize tracking gate ────────────────────────────────────
    let trackingActivationTime = null;
    let trackingResolved = false; // guards against double allow/deny on one load
    let cancelConsentPoll = () => {}; // set once the fallback poll starts

    // Single gate. fromCookie=true checks "C0002:1" (stored form); every live
    // signal checks bare "C0002". This is the ONLY place that distinction lives.
    // The Webflow Browser API (wf.*) is only safe to CALL inside wf.ready() —
    // `wf` can exist as an object before its methods are defined, which throws
    // "wf.getUserTrackingChoice is not a function" if we call it too early.
    // So we split resolution (sync, no wf needed) from the action (deferred to
    // wf.ready). We remember the latest decision and apply it whenever wf is
    // ready — whichever happens first.
    let pendingDecision = null; // true = allow, false = deny, null = undecided
    let wfIsReady = false;

    const applyDecisionToWf = () => {
      if (!wfIsReady || pendingDecision === null) return;
      try {
        if (pendingDecision) {
          if (wf.getUserTrackingChoice() !== 'allow') {
            wf.allowUserTracking({ activate: true });
          }
        } else {
          wf.denyUserTracking();
        }
      } catch (e) {
        logger('[consent] wf tracking call failed:', e.message);
      }
    };

    const resolveConsent = (groups, { fromCookie = false } = {}) => {
      if (trackingResolved) return;
      trackingResolved = true;
      cancelConsentPoll(); // stop the fallback poll if it's running

      const hasPerformance = fromCookie ? groups.includes('C0002:1') : groups.includes('C0002');

      if (hasPerformance) {
        logger('[consent] Performance consent granted — will activate tracking when wf ready');
        trackingActivationTime = Date.now();
        pendingDecision = true;
      } else {
        logger('[consent] Performance consent denied — will block tracking when wf ready');
        pendingDecision = false;
      }
      applyDecisionToWf(); // applies now if wf already ready, else waits for it
    };

    // dataLayer intercept — most reliable path in Safari Private.
    window.dataLayer = window.dataLayer || [];
    const _originalPush = window.dataLayer.push.bind(window.dataLayer);
    window.dataLayer.push = function (obj) {
      _originalPush(obj);
      if (!trackingResolved && (obj.event === 'OneTrustGroupsUpdated' || obj.event === 'OptanonLoaded') && obj.OnetrustActiveGroups) {
        logger('[consent] Caught consent via dataLayer intercept:', obj.OnetrustActiveGroups);
        resolveConsent(obj.OnetrustActiveGroups);
      }
    };

    // Cookie check — returning visitors (incl. default consent) resolved at once.
    const getConsentFromCookie = () => {
      const otCookie = document.cookie.split('; ').find((row) => row.startsWith('OptanonConsent='));
      if (!otCookie) return null;
      const groupsParam = otCookie.split('&').find((row) => row.startsWith('groups='));
      if (!groupsParam) return null;
      return decodeURIComponent(groupsParam.split('=')[1]);
    };

    const cookieGroups = getConsentFromCookie();
    if (cookieGroups) {
      logger('[consent] Cookie found on load:', cookieGroups);
      resolveConsent(cookieGroups, { fromCookie: true });
    } else {
      logger('[consent] No cookie — waiting for OneTrust');
      window.addEventListener(
        'OneTrustGroupsUpdated',
        (event) => {
          const activeGroups = event.detail.join(', ');
          logger('[consent] OneTrustGroupsUpdated:', activeGroups);
          resolveConsent(activeGroups);
        },
        { once: true },
      );
    }

    // User changes settings in the preference center — re-evaluate the gate.
    // Cancel any in-flight poll first, then re-open the gate so a straggler
    // can't re-fire after we reset the flag.
    window.addEventListener('OTConsentApplied', (event) => {
      logger('[consent] OTConsentApplied fired (User updated settings)', JSON.stringify(event));
      cancelConsentPoll();
      trackingResolved = false;
      resolveConsent(window.OnetrustActiveGroups || '');
    });

    // Polling fallback — last resort if the dataLayer intercept missed it.
    // Parse groups (don't trust the raw string; a leading comma makes it
    // truthy before real groups resolve).
    cancelConsentPoll = pollUntil(
      () => {
        if (trackingResolved) return true;
        const groups = window.OnetrustActiveGroups;
        const parsed = groups ? groups.split(',').filter(Boolean) : [];
        if (parsed.length > 0) {
          logger('[consent] Caught consent via polling:', groups);
          resolveConsent(groups);
          return true;
        }
        return false;
      },
      { every: 200, timeout: 3000 },
    );

    // ── Experiment tracking — fires when Optimize records a variation ───────
    const initWfLogic = () => {
      logger('[consent] wf.ready fired');

      // wf methods are now safe to call. Apply any consent decision that
      // resolved before wf was ready (the common case — the consent cookie is
      // read synchronously, well before the Browser API finishes loading).
      wfIsReady = true;
      applyDecisionToWf();

      wf.onVariationRecorded((result) => {
        logger('[consent] Variation recorded:', result);

        const duration = trackingActivationTime ? Date.now() - trackingActivationTime : 0;
        logger('[mixpanel] Latency calculated:', `${duration}ms`);

        const eventProps = {
          experimentName: result.experienceName,
          variantName: result.variationName,
          experienceType: result.experienceType,
          latency_ms: duration,
        };

        // Pick the Mixpanel instance first (tee on /about-tee, else default),
        // then send once. Guard the instance before reading .track so an early
        // tick can't throw before Mixpanel finishes loading.
        pollUntil(
          () => {
            const isTee = window.location.href.includes('talkspace.com/about-tee');
            const mp = isTee ? window.mixpanel?.tee : window.mixpanel;
            if (mp && typeof mp.track === 'function') {
              mp.track('TS Experiment Session', eventProps);
              logger(`[mixpanel] TS Experiment Session tracked${isTee ? ' (tee)' : ''}`);
              return true;
            }
            return false;
          },
          { every: 200, timeout: 10000 },
        );
      });
    };

    try {
      wf.ready(initWfLogic);
    } catch (e) {
      logger('[consent] wf.ready unavailable — skipping Optimize variation tracking:', e.message);
    }

    // ── Segment anon ID → Optimize identification (wf.setUserId) ─────────────
    const getSegmentAnonId = () => {
      try {
        const fromStorage = localStorage.getItem('ajs_anonymous_id');
        if (fromStorage) {
          try {
            return JSON.parse(fromStorage);
          } catch {
            return fromStorage;
          }
        }
      } catch (e) {
        // localStorage blocked in Safari Private — fail silently
      }
      const cookie = document.cookie.split('; ').find((row) => row.startsWith('ajs_anonymous_id='));
      if (cookie) {
        return decodeURIComponent(cookie.split('=')[1]).replace(/^"|"$/g, '');
      }
      return null;
    };

    pollUntil(
      () => {
        const anonId = getSegmentAnonId();
        if (!anonId) return false;
        logger('[segment] Anonymous ID found:', anonId);
        if (window.wf && typeof wf.setUserId === 'function') {
          wf.setUserId('anonId', anonId);
          logger('[intellimize] setUserId called with anonId:', anonId);
        }
        return true; // stop once the ID is found, regardless of wf availability
      },
      { every: 500, timeout: 10000 },
    );
  })();
</script>
<!-- OneTrust Cookies Consent -->

