{
  "manifest_version": 3,
  "name": "JobBot v3.2 Platform-First Search Runner",
  "short_name": "JobBot v3.2",
  "version": "3.2.1",
  "version_name": "3.2.3-final-closure",
  "description": "Local read-only exhaustive job-search runner for normal Chrome using a tokenized loopback bridge. No applications, forms, or challenge bypass.",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "windows"
  ],
  "host_permissions": [
    "https://linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://indeed.com/*",
    "https://*.indeed.com/*",
    "https://glassdoor.com/*",
    "https://*.glassdoor.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://linkedin.com/*",
        "https://*.linkedin.com/*"
      ],
      "js": [
        "selectors.js",
        "common.js",
        "linkedin.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://indeed.com/*",
        "https://*.indeed.com/*"
      ],
      "js": [
        "selectors.js",
        "common.js",
        "indeed.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://glassdoor.com/*",
        "https://*.glassdoor.com/*"
      ],
      "js": [
        "selectors.js",
        "common.js",
        "glassdoor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "JobBot v3.2"
  },
  "web_accessible_resources": []
}
