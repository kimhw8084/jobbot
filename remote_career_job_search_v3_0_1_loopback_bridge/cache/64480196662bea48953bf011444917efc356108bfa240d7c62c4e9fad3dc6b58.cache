</style>
<script>
  (function () {
    'use strict';
    window.Webflow = window.Webflow || [];
    window.Webflow.push(function () {
      var header = document.querySelector('.help-panel-header');
      var panel = document.querySelector('.help-panel-options');
      if (!header || !panel) return;

      header.setAttribute('aria-expanded', 'false');
      panel.setAttribute('aria-hidden', 'true');
      panel.style.cssText = 'display:none; opacity:0; transition: opacity 0.3s ease;';

      function toggle() {
        var isOpen = header.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          panel.style.opacity = '0';
          header.setAttribute('aria-expanded', 'false');
          panel.setAttribute('aria-hidden', 'true');
          function handleClose(e) {
            if (e.propertyName !== 'opacity') return;
            panel.removeEventListener('transitionend', handleClose);
            panel.style.display = 'none';
          }
          panel.addEventListener('transitionend', handleClose);
        } else {
          panel.style.display = 'block';
          panel.setAttribute('aria-hidden', 'false');
          void panel.scrollHeight;
          panel.style.opacity = '1';
          header.setAttribute('aria-expanded', 'true');
        }
      }

      header.addEventListener('click', toggle);
      header.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggle();
        }
      });
    });
  })();
</script></div></div><div class="footer__section"><div class="container w-container"><div class="footer-top-wrapper"><div id="w-node-ce02b28c-2f0a-9e6b-5e2c-eb6f92cf7929-92cf7927" class="footer-top-col _1st"><a href="/" class="footer-logo w-inline-block"><img src="https://cdn.prod.website-files.com/61f7c8145fe6f608faa84b36/6a8507cf1e50e5918706ced1_bicyclehealth-newlogo.svg" loading="lazy" alt="Bicycle Health - Virtual Care for Opioid Recovery Homepage" class="footer-logo-img"/></a><div class="block--contact-details"><a data-wf--button----variations--variant="outline-solid-white" data-w-id="be8f4379-cc79-067e-efd8-950b7aeca046" href="/contact-us" class="c-btn w-variant-6dc509ee-eaae-9ed1-91fe-ee032152c4da w-inline-block"><div class="c-btn--text">Contact Us</div><div class="c-btn--icon w-embed"><svg width="15" height="13" viewBox="0 0 15 13" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
