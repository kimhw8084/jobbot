description":null,"label":"Which of the following do you have hands-on experience with?","required":true,"fields":[{"name":"question_18173129008[]","type":"multi_value_multi_select","values":[{"label":"Prior authorization","value":43451260008},{"label":"Insurance claims processing","value":43451261008},{"label":"Patient access case management","value":43451262008},{"label":"Coverage criteria and policy review","value":43451263008},{"label":"Healthcare provider coordination","value":43451264008},{"label":"None of the above","value":43451265008}]}]},{"description":null,"label":"Have you directly supervised a team, and if so, how many direct reports have you managed?","required":true,"fields":[{"name":"question_18189820008","type":"multi_value_single_select","values":[{"label":"I have not supervised a team","value":43517846008},{"label":"1–3 direct reports","value":43517847008},{"label":"4–6 direct reports","value":43517848008},{"label":"7–10 direct reports","value":43517849008},{"label":"10+ direct reports","value":43517850008}]}]},{"description":null,"label":"Please share your compensation expectations.","required":true,"fields":[{"name":"question_18173130008","type":"textarea","values":[]}]}],"location_questions":[]}