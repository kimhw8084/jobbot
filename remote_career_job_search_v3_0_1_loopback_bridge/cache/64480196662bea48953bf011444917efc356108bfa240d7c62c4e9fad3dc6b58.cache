          let c = ca[i].trim();
          if (c.indexOf(name) === 0) {
              return c.substring(name.length);
          }
      }
      return "";
  }

  function setCookie(cname, cvalue, exdays) {
      const d = new Date();
      d.setTime(d.getTime() + (exdays * 24 * 60 * 60 * 1000));
      const expires = "expires=" + d.toUTCString();
      document.cookie = cname + "=" + cvalue + ";" + expires + ";path=/;secure";
  }

  // True once a real, fully loaded Mixpanel SDK instance exists
  // (the GTM template's wrapper and the loader stub don't expose get_distinct_id)
  function isRealInstance() {
      return !!(window.mixpanel && typeof window.mixpanel.get_distinct_id === 'function');
  }

  // Everything that runs once Mixpanel is ready, regardless of who initialised it
  function onMixpanelReady() {
      if (trackingStarted) return;
      trackingStarted = true;

      try {
          const { debug } = getDomainInfo();

          // Get and process distinct_id
          let distinct_id = getCookie('mixp_id') || mixpanel.get_distinct_id();
          if (distinct_id.startsWith('$device:')) {
              distinct_id = distinct_id.substring('$device:'.length);
          }

          // Handle cookie and identification
          if (!getCookie('mixp_id')) {
              setCookie('mixp_id', distinct_id, CONFIG.COOKIE_EXPIRY);
              if (!debug) {
                  mixpanel.identify(distinct_id);
                  mixpanel.people.set({ "USER_ID": distinct_id });
              }
          } else {
              if (!debug) {
                  mixpanel.identify(distinct_id);
              }
          }

          // Track page view
          const pageViewData = {
              'page name': document.title,
              'url': window.location.pathname
          };

          if (!debug) {
              mixpanel.track('page viewed', pageViewData);
          } else {
              console.log('page viewed', pageViewData);
          }

          // Initialize event tracking
          initializeEventTracking();

          // Initialize scroll depth tracking
          initializeScrollDepthTracking();
      } catch (error) {
          console.error('Mixpanel ready handler error: ' + error.message);
      }
  }

  // Fallback path: load the library and initialise it ourselves
  // (staging/other domains, or production when GTM never delivers an instance)
  function selfInit() {
      if (trackingStarted || isRealInstance()) {
          if (isRealInstance()) onMixpanelReady();
          return;
      }

      loadMixpanelLibrary();

      const { token, debug } = getDomainInfo();

      mixpanel.init(token, {
          debug: debug,
          cross_site_cookie: false,
          secure_cookie: true,
          batch_requests: false,
          loaded: function() {
              onMixpanelReady();
          }
      });
  }

  // Mixpanel bootstrap: on production, the GTM Mixpanel template loads and
  // initialises the SDK (Consent Initialization - All Pages). This script only
  // waits for that instance, then attaches identify/page view/event tracking.
  function initMaster() {
      const { isProduction } = getDomainInfo();

      // Staging and any other domain: GTM init is excluded there, so load it ourselves
      if (!isProduction) {
          selfInit();
          return;
      }

      if (isRealInstance()) {
          onMixpanelReady();
          return;
      }

      let waited = 0;
      const timer = setInterval(function() {
          waited += CONFIG.POLL_MS;
          if (isRealInstance()) {
              clearInterval(timer);
              onMixpanelReady();
          } else if (waited >= CONFIG.GTM_WAIT_MS) {
              clearInterval(timer);
              selfInit();
          }
      }, CONFIG.POLL_MS);
  }

  // Event tracking parser
  function parseTrackingData(data, value) {
      try {
          if (!data) {
              throw new Error('Data attribute is missing');
          }

          const parts = data.split('|');
          const action = parts[0];
          const label = parts[1];
          if (!action || !label) {
              throw new Error('Invalid tracking data format');
          }

          return {
              action: action,
              label: label,
              value: (value !== null && value !== '' && !isNaN(value)) ? Number(value) : undefined
          };
      } catch (error) {
          console.error('Tracking parser error: ' + error.message);
          return {};
      }
  }

  // Initialize event tracking (delegated, so it works no matter when
  // data-tracker attributes are added to the DOM)
  function initializeEventTracking() {
      try {
          const { debug } = getDomainInfo();

          document.addEventListener('click', function(event) {
              const target = event.target;
              if (!target || typeof target.closest !== 'function') return;

              // 1) data-tracker elements (delegated)
              const trackerEl = target.closest('[data-tracker]');
              if (trackerEl) {
                  const trackData = trackerEl.getAttribute('data-tracker');
                  const trackValue = trackerEl.getAttribute('data-tracker-value');
                  const params = parseTrackingData(trackData, trackValue);

                  if (params.action && params.label) {
                      const eventData = {
                          label: params.label,
                          value: params.value
                      };

                      if (!debug) {
                          mixpanel.track(params.action, eventData);
                      } else {
                          console.log(params.action, eventData);
                      }
                  }
              }

              // 2) all link clicks
              const link = target.closest('a');
              if (link) {
                  const eventData = {
                      'Click Text': link.textContent.trim(),
                      'Clicked URL': link.href,
                      'Current URL': window.location.href
                  };

                  if (!debug) {
                      mixpanel.track('Clicked Link', eventData);
                  } else {
                      console.log('Clicked Link', eventData);
                  }
              }
          });
      } catch (error) {
          console.error('Event tracking initialization error: ' + error.message);
      }
  }

  // Initialize scroll depth tracking
  function initializeScrollDepthTracking() {
      try {
          const { debug } = getDomainInfo();
          const trackedThresholds = new Set();

          // Debounce function for performance
          function debounce(func, wait) {
              let timeout;
              return function() {
                  const context = this;
                  const args = arguments;
                  clearTimeout(timeout);
                  timeout = setTimeout(function() {
                      func.apply(context, args);
                  }, wait);
              };
          }

          function trackScrollDepth() {
              const scrollTop = window.scrollY || document.documentElement.scrollTop;
              const docHeight = Math.max(
                  document.body.scrollHeight,
                  document.documentElement.scrollHeight
              ) - window.innerHeight;

              // Avoid division by zero on short pages
              if (docHeight <= 0) return;

              const scrollPercent = Math.round((scrollTop / docHeight) * 100);

              CONFIG.SCROLL_THRESHOLDS.forEach(function(threshold) {
                  if (scrollPercent >= threshold && !trackedThresholds.has(threshold)) {
                      trackedThresholds.add(threshold);

                      const eventData = {
                          'Scroll Depth': threshold,
                          'Page Name': document.title,
                          'URL': window.location.pathname
                      };

                      if (!debug) {
                          mixpanel.track('Scroll Depth', eventData);
                      } else {
                          console.log('Scroll Depth', eventData);
                      }
                  }
              });
          }

          // Attach debounced scroll listener
          window.addEventListener('scroll', debounce(trackScrollDepth, 150));

          // Check initial scroll position (for users who land mid-page via anchor links)
          trackScrollDepth();

      } catch (error) {
          console.error('Scroll depth tracking initialization error: ' + error.message);
      }
  }

  // Initialize the script
  initMaster();
})();
</script>

<script>
(function () {
  'use strict';

  var businessStatus = {
    isOpen: false
  };

  function getIsBusinessOpen() {
    function isHoliday(today) {
      // Holidays with reduced hours (9am-5:30pm)
      var holidays = [
        "01-01",  // New Year's Day
        "01-19",  // MLK Day 2026
        "02-16",  // Presidents Day 2026
        "05-25",  // Memorial Day 2026
        "07-04",  // Independence Day
        "09-07",  // Labor Day 2026
        "10-12",  // Columbus Day 2026
        "11-11",  // Veterans Day
      ];
      var formattedDate =
        (today.getMonth() + 1).toString().padStart(2, "0") +
        "-" +
        today.getDate().toString().padStart(2, "0");
      return holidays.includes(formattedDate);
    }

    function isClosedHoliday(today) {
      // Completely CLOSED holidays
      var closedHolidays = [
        "11-26",  // Thanksgiving 2026
        "12-25",  // Christmas
      ];
      var formattedDate =
        (today.getMonth() + 1).toString().padStart(2, "0") +
        "-" +
        today.getDate().toString().padStart(2, "0");
      return closedHolidays.includes(formattedDate);
    }

    var today = new Date().toLocaleString("en-US", {
      timeZone: "America/New_York",
    });
    today = new Date(today);
    var dayOfWeek = today.getDay();
    var hour = today.getHours();
    var minutes = today.getMinutes();
    var time = hour + minutes / 60;
    var isWeekend = dayOfWeek === 0 || dayOfWeek === 6;

    if (isClosedHoliday(today)) {
      // Completely closed on these holidays
      businessStatus.isOpen = false;
    } else if (isHoliday(today)) {
      // Other holiday hours: 9am-5:30pm
      businessStatus.isOpen = time >= 9 && time < 17.5;
    } else if (isWeekend) {
      // Weekend hours: 11am-7:30pm
      businessStatus.isOpen = time >= 11 && time < 19.5;
    } else {
      // Weekday hours: 8am-8pm
      businessStatus.isOpen = time >= 8 && time < 20;
    }

    return businessStatus.isOpen;
  }

  function updatePatientScreenerURL() {
    var isBusinessOpen = getIsBusinessOpen();

    try {
      var links = document.querySelectorAll('a[href*="jotform.com"], a[href*="enrollment-step-1"]');

      links.forEach(function (element) {
        try {
          var currentHref = element.getAttribute('href');
          if (!currentHref) return;

          var newURL = new URL(currentHref, window.location.href);
          var existingParams = new URLSearchParams(newURL.search);

          // Authored params on the link win; page URL params only fill gaps
          var pageParams = new URLSearchParams(window.location.search);
          pageParams.forEach(function (value, key) {
            if (!existingParams.has(key)) {
              existingParams.set(key, value);
            }
          });

          // hours must always refresh so open/closed can flip mid-visit
          existingParams.set('hours', isBusinessOpen ? 'open' : 'closed');

          newURL.search = existingParams.toString();
          element.setAttribute('href', newURL.toString());
        } catch (err) {
          console.error('Error updating individual link:', err);
        }
      });
    } catch (err) {
      console.error('Error in URL update process:', err);
    }
  }

  function init() {
    getIsBusinessOpen();
    window.BusinessStatus = businessStatus;
    updatePatientScreenerURL();

    setInterval(function () {
      getIsBusinessOpen();
      updatePatientScreenerURL();
    }, 60000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

<script>
(function () {
    'use strict';

    // Set data trackers for links based on their path, ignoring query strings and hashes
    function getTracker(href) {
        if (!href) return null;
        if (href.charAt(0) === '#') return null;

        var lower = href.toLowerCase();
        if (lower.indexOf('mailto:') === 0 || lower.indexOf('tel:') === 0 || lower.indexOf('javascript:') === 0) return null;

        var path;
        try {
            path = new URL(href, window.location.href).pathname.toLowerCase();
        } catch (e) {
            path = lower;
        }

        if (path.indexOf('/we-are-here-to-help') !== -1) return 'click_get_started|Global';
        if (path.indexOf('/partners/referral') !== -1) return 'click_referral_partner|Global';
        if (path.indexOf('/refer') !== -1) return 'click_refer_patient|Global';
        return null;
    }

    function init() {
        var links = document.querySelectorAll('a[href]');
        links.forEach(function (link) {
            var tracker = getTracker(link.getAttribute('href'));
            if (tracker) {
                link.setAttribute('data-tracker', tracker);
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>

<script>
(function () {
    'use strict';

    var bitrixWidget;
    window.addEventListener('onBitrixLiveChat', function (event) {
        var widget = event.detail.widget;
        bitrixWidget = widget;
        widget.subscribe({
            type: BX.LiveChatWidget.SubscriptionType.sessionStart,
            callback: function (data) {
                if (typeof fbq === 'function') {
                    fbq('track', 'Live Chat');
                    fbq('track', 'Lead Capture Event Group');
                }
            }
        });
    });

    // Open chat on clicks (delegated and guarded in case the widget hasn't loaded yet)
    document.addEventListener('click', function (e) {
        var target = e.target;
        if (!target || typeof target.closest !== 'function') return;
        var trigger = target.closest('.chat-with-us');
        if (trigger && bitrixWidget) {
            bitrixWidget.open();
        }
    });

    // External link handling: nofollow all off-site links, force _self unless marked .trusted
    function initLinks() {
        var anchors = document.querySelectorAll('a[href^="http"], a[href^="//"]');
        anchors.forEach(function (a) {
            var href = a.getAttribute('href') || '';
            if (href.indexOf(window.location.host) !== -1) return;

            a.setAttribute('rel', 'nofollow noopener noreferrer');
            if (!a.classList.contains('trusted')) {
                a.setAttribute('target', '_self');
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLinks);
    } else {
        initLinks();
    }
})();
</script>

<script>
(function () {
  'use strict';

  var BASE    = 'https://bicyclehealth.com';
  var ORG_ID  = BASE + '/#organization';
  var SITE_ID = BASE + '/#website';
  var LOGO    = 'https://cdn.prod.website-files.com/61f7c8145fe6f608faa84b36/69ae0476f269310df11fb642_bicyclehealth-logo.png';

  var STATES = ['AZ','CA','CO','CT','DE','FL','ID','IL','IA','ME','MD','MI',
                'MN','MT','NE','NV','NM','NC','ND','OR','PA','SD','TX','VA',
                'WA','WI','WY'].map(function(s){ return 'US-' + s; });

  var SOCIAL = [
    'https://www.linkedin.com/company/bicyclehealth',
    'https://www.facebook.com/bicyclehealth/',
    'https://twitter.com/bicyclehealth'
  ];

  var LABELS = {
    'insurances-logo':        'Insurance Partners',
    'presses':                'Press',
    'state-coverage-details': 'State Coverage',
    'state-details':          'State Details',
    'belbuca':'Belbuca', 'buprenorphine':'Buprenorphine', 'carfentanil':'Carfentanil',
    'codeine':'Codeine', 'demerol':'Demerol', 'dilaudid':'Dilaudid',
    'fentanyl':'Fentanyl', 'heroin':'Heroin', 'hydrocodone':'Hydrocodone',
    'lortab':'Lortab', 'lucemyra':'Lucemyra', 'morphine':'Morphine',
    'opioid-use-disorder':'Opioid Use Disorder',
    'oxycodone':'Oxycodone', 'oxycontin':'OxyContin', 'percocet':'Percocet',
    'sublocade':'Sublocade', 'subutex':'Subutex', 'tapentadol':'Tapentadol',
    'tramadol':'Tramadol', 'zubsolv':'Zubsolv',
    'ak':'Alaska','al':'Alabama','az':'Arizona','ca':'California',
    'co':'Colorado','ct':'Connecticut','de':'Delaware','fl':'Florida',
    'ga':'Georgia','ia':'Iowa','id':'Idaho','il':'Illinois',
    'in':'Indiana','ks':'Kansas','ky':'Kentucky','la':'Louisiana',
    'ma':'Massachusetts','md':'Maryland','me':'Maine','mi':'Michigan',
    'mn':'Minnesota','mo':'Missouri','ms':'Mississippi','mt':'Montana',
    'nc':'North Carolina','nd':'North Dakota','ne':'Nebraska','nv':'Nevada',
    'nh':'New Hampshire','nj':'New Jersey','nm':'New Mexico','ny':'New York',
    'oh':'Ohio','ok':'Oklahoma','or':'Oregon','pa':'Pennsylvania',
    'ri':'Rhode Island','sc':'South Carolina','sd':'South Dakota',
    'tn':'Tennessee','tx':'Texas','ut':'Utah','va':'Virginia',
    'vi':'Virgin Islands','vt':'Vermont','wa':'Washington',
    'wadc':'Washington DC','wi':'Wisconsin','wv':'West Virginia','wy':'Wyoming',
    'medicaid-mt':'Montana Medicaid','medicaid-nc':'North Carolina Medicaid',
    'medicaid-nv':'Nevada Medicaid','medicaid-pa':'Pennsylvania Medicaid',
    'medicaid-wi':'Wisconsin Medicaid'
  };

  // ── Helpers ──────────────────────────────────────────────────────

  function meta(selector, attr) {
    var el = document.querySelector(selector);
    return el ? (el.getAttribute(attr) || '').trim() : '';
  }

  function pageName() {
    return (document.title || '')
      .replace(/\s*[\|\-\u2013\u2014]\s*Bicycle Health\s*$/i, '').trim()
      || 'Bicycle Health';
  }

  function pageDesc() {
    return meta('meta[property="og:description"]', 'content')
        || meta('meta[name="description"]', 'content')
        || 'Bicycle Health provides telehealth treatment for opioid use disorder across the US.';
  }

  function pathname() {
    return window.location.pathname.replace(/\/$/, '').toLowerCase() || '/';
  }

  function humanise(slug) {
    return (LABELS[slug] || slug
      .replace(/-[0-9a-f]{5,6}$/i, '')
      .replace(/-/g, ' ')
      .replace(/\b\w/g, function(c){ return c.toUpperCase(); }));
  }

  // ── Breadcrumb builder ───────────────────────────────────────────

  function breadcrumbs(path, title) {
    var items = [{ name: 'Home', url: BASE + '/', isLast: path === '/' }];
    if (path === '/') return items;

    var segs = path.replace(/^\//, '').split('/');

    segs.forEach(function(seg, i) {
      var isLast = i === segs.length - 1;
      items.push({
        name:   isLast ? title : humanise(seg),
        url:    BASE + '/' + segs.slice(0, i + 1).join('/'),
        isLast: isLast
      });
    });

    return items;
  }

  // ── Schema factories ─────────────────────────────────────────────

  function org() {
    return {
      '@context':   'https://schema.org',
      '@type':      'Organization',
      '@id':        ORG_ID,
      name:         'Bicycle Health',
      url:          BASE + '/',
      logo:         { '@type': 'ImageObject', url: LOGO },
      image:        LOGO,
      description:  "Bicycle Health is the nation's leading telehealth provider of evidence-based medication for opioid use disorder (MOUD), combining FDA-approved medication-assisted treatment (MAT), therapy, and peer support to help people recover from opioid addiction.",
      telephone:    '+18449432514',
      email:        'contact@bicyclehealth.com',
      foundingDate: '2017',
      address: {
        '@type':         'PostalAddress',
        streetAddress:   '68 Harrison Avenue, Suite 600',
        addressLocality: 'Boston',
        addressRegion:   'MA',
        postalCode:      '02111',
        addressCountry:  'US'
      },
      areaServed:   STATES,
      sameAs:       SOCIAL,
      contactPoint: {
        '@type':           'ContactPoint',
        contactType:       'patient enrollment',
        telephone:         '+18449432514',
        areaServed:        'US',
        availableLanguage: ['English']
      }
    };
  }

  function medOrg() {
    return {
      '@context':     'https://schema.org',
      '@type':        ['MedicalOrganization', 'MedicalClinic'],
      '@id':          BASE + '/#medicalorganization',
      additionalType: 'https://schema.org/AddictionTreatmentCenter',
      name:           'Bicycle Health',
      url:            BASE + '/',
      logo:           LOGO,
      image:          LOGO,
      description:    'Bicycle Health provides virtual medication-assisted treatment (MAT) for opioid use disorder (OUD) using Suboxone and behavioral therapy.',
      medicalSpecialty: [
        'https://schema.org/Psychiatric',
        'https://schema.org/Toxicologic'
      ],
      isAcceptingNewPatients: true,
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name:    'Opioid Use Disorder Treatment Services',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'MedicalTherapy', name: 'Opioid Use Disorder Treatment', sameAs: 'https://en.wikipedia.org/wiki/Opioid_use_disorder' } },
          { '@type': 'Offer', itemOffered: { '@type': 'MedicalTherapy', name: 'Medication-Assisted Treatment (MAT)' } },
          { '@type': 'Offer', itemOffered: { '@type': 'MedicalTherapy', name: 'Suboxone (Buprenorphine/Naloxone) Prescribing' } },
          { '@type': 'Offer', itemOffered: { '@type': 'MedicalTherapy', name: 'Behavioural Health Therapy' } },
          { '@type': 'Offer', itemOffered: { '@type': 'MedicalTherapy', name: 'Peer Support Groups' } }
        ]
      },
      telephone:  '+18449432514',
      priceRange: '$$',
      address: {
        '@type':         'PostalAddress',
        streetAddress:   '68 Harrison Avenue, Suite 600',
        addressLocality: 'Boston',
        addressRegion:   'MA',
        postalCode:      '02111',
        addressCountry:  'US'
      },
      openingHoursSpecification: [
        {
          '@type':     'OpeningHoursSpecification',
          dayOfWeek:   ['Monday','Tuesday','Wednesday','Thursday','Friday'],
          opens:       '08:00',
          closes:      '20:00'
        },
        {
          '@type':     'OpeningHoursSpecification',
          dayOfWeek:   ['Saturday','Sunday'],
          opens:       '11:00',
          closes:      '19:30'
        }
      ],
      areaServed: STATES,
      sameAs:     SOCIAL
    };
  }

  function webpage(url, name, desc, bcId) {
    return {
      '@context':  'https://schema.org',
      '@type':     'WebPage',
      '@id':       url + '#webpage',
      url:         url,
      name:        name,
      description: desc,
      isPartOf:    { '@id': SITE_ID },
      publisher:   { '@id': ORG_ID },
      breadcrumb:  { '@id': bcId },
      inLanguage:  'en-US',
      speakable: {
        '@type':     'SpeakableSpecification',
        cssSelector: ['h1']
      }
    };
  }

  function breadcrumbList(url, crumbs) {
    return {
      '@context': 'https://schema.org',
      '@type':    'BreadcrumbList',
      '@id':      url + '#breadcrumb',
      itemListElement: crumbs.map(function(c, i) {
        var entry = { '@type': 'ListItem', position: i + 1, name: c.name };
        if (!c.isLast) entry.item = c.url;
        return entry;
      })
    };
  }

  // ── Run ──────────────────────────────────────────────────────────
  (function() {
    var path   = pathname();
    var url    = BASE + (path === '/' ? '/' : path);
    var name   = pageName();
    var desc   = pageDesc();
    var crumbs = breadcrumbs(path, name);
    var bcId   = url + '#breadcrumb';

    try {
      var s  = document.createElement('script');
      s.type = 'application/ld+json';
      s.text = JSON.stringify([org(), medOrg(), webpage(url, name, desc, bcId), breadcrumbList(url, crumbs)], null, 2);
      document.head.appendChild(s);
    } catch(e) {}
  })();

})();
</script>

<script>
  (function () {
    'use strict';
    window.Webflow = window.Webflow || [];
    window.Webflow.push(function () {
      var skipLink = document.querySelector('.is__skip--content');
      var main = document.getElementById('main-content');
      if (!skipLink || !main) return;

      // Make the main content focusable (no Designer attribute needed)
      main.setAttribute('tabindex', '-1');

      skipLink.addEventListener('click', function (e) {
        e.preventDefault();
        main.focus();
        // Keep the hash in the URL without re-triggering the default jump
        if (history.replaceState) {
          history.replaceState(null, '', '#main-content');
        }
      });
    });
  })();
</script><script src="https://boards.greenhouse.io/embed/job_board/js?for=bicyclehealth"></script>
</body></html>